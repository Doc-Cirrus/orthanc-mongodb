# Settings of the compose environments of this folder. Copy this file to
# ".env" (git-ignored) and change what you need; every value below is the
# default used when the variable is not set. Relative paths are relative to
# this folder.

# --- Compose -----------------------------------------------------------------

# The project name is "orthanc-mongodb" (set in docker-compose.yml), so the
# volumes and the network are shared by every environment.

# To combine several environments instead of copying one override file to
# "docker-compose.override.yaml", list the files here (":"-separated):
# COMPOSE_FILE=docker-compose.yml:docker-compose.override.dev.yaml.example:docker-compose.override.runtime.yaml.example

# --- Versions ----------------------------------------------------------------

# MongoDB server image (7.0 or later)
MONGO_IMAGE=mongo:7.0

# CMake build type of the plugins and the unit tests: Release or Debug
BUILD_TYPE=Release

# Linux Standard Base downloads of the runtime image:
# https://orthanc.uclouvain.be/downloads/linux-standard-base/index.html
ORTHANC_VERSION=1.13.0
ORTHANC_EXPLORER_2_VERSION=1.15.0
STONE_WEB_VIEWER_VERSION=3.0
ORTHANC_DICOMWEB_VERSION=1.24

# --- Development (docker-compose.override.dev.yaml.example) -----------------

# Sources of Orthanc 1.13.0 and of the Orthanc PostgreSQL plugin 11.0, mounted
# in the dev shell at /usr/local/orthanc and /usr/local/orthanc-postgress
ORTHANC_SOURCES=../../../orthanc/Orthanc-1.13.0
POSTGRESQL_SOURCES=../../../orthanc/OrthancPostgreSQL-11.0

# --- Runtime (docker-compose.override.runtime.yaml.example) -----------------

# Ports published on the host
ORTHANC_HTTP_PORT=8042
ORTHANC_DICOM_PORT=4242

# MongoDB connection URI of Orthanc, with the database name. For the replica
# set: mongodb://database-rs:27017/inpacs?replicaSet=rs0
ORTHANC_MONGO_URL=mongodb://database:27017/inpacs

# Options of the "MongoDB" section of Resources/Config/configuration.json (see
# docs/PLUGIN_CONFIGURATION.md). Orthanc writes these values into the JSON
# as they are: use true or false, a number, and Auto, true or false for the
# transactions.
MONGODB_ENABLE_INDEX=true
MONGODB_ENABLE_STORAGE=true
MONGODB_ENABLE_TRANSACTIONS=Auto
MONGODB_INDEX_CONNECTIONS_COUNT=5
MONGODB_CREATE_INDEXES_AT_STARTUP=true
MONGODB_ENABLE_EXTENDED_FIND=true

# --- Seeding (the "dicom-sender" service of the runtime environment) --------

# The first "docker compose up" seeds Orthanc with the sample studies, the next
# ones do nothing (see DicomSender/README.md). "false" never seeds.
SEED_ENABLED=true

# Samples to send: comma-separated identifiers of DicomSender/dicom-sources.json
# (empty: all of them, about 650 MB)
SEED_SOURCES=
# Number of copies of the samples, each as new studies of new patients
SEED_COPIES=1
# Number of parallel DICOM associations
SEED_PROCESSES=2
