{
  "RemoteAccessAllowed": true,
  "AuthenticationEnabled": false,
  "DicomAlwaysAllowFind": true,
  "DicomAlwaysAllowFindWorklist": true,
  "DicomAlwaysAllowGet": true,
  "DicomAlwaysAllowMove": true,
  "DicomCheckModalityHost": true,
  "Plugins": ["/usr/local/runtime"],
  "ExtraMainDicomTags": {
    "Instance": [
      "Rows",
      "Columns",
      "ImageType",
      "SOPClassUID",
      "ContentDate",
      "ContentTime",
      "FrameOfReferenceUID",
      "PixelSpacing",
      "SpecificCharacterSet",
      "BitsAllocated",
      "BitsStored",
      "RescaleSlope",
      "RescaleIntercept",
      "SliceThickness",
      "WindowCenter",
      "WindowWidth",
      "PhotometricInterpretation",
      "PixelRepresentation"
    ],
    "Series": [
      "TimezoneOffsetFromUTC",
      "PerformedProcedureStepStartDate",
      "PerformedProcedureStepStartTime",
      "RequestAttributesSequence"
    ],
    "Study": ["TimezoneOffsetFromUTC"],
    "Patient": []
  },
  "StoneWebViewer": {
    "DicomCacheSize": 2048
  },
  "DicomWeb": {
    "Enable": true,
    "MetadataWorkerThreadsCount": 10,
    "StudiesMetadata": "MainDicomTags",
    "SeriesMetadata": "MainDicomTags"
  },
  "OrthancExplorer2": {
    "Enable": true,
    "IsDefaultOrthancUI": true
  },
  "MongoDB": {
    "ConnectionUri": "${MONGO_URL}",
    "EnableIndex": ${MONGODB_ENABLE_INDEX:-true},
    "EnableStorage": ${MONGODB_ENABLE_STORAGE:-true},
    "ChunkSize": 261120,
    "IndexConnectionsCount": ${MONGODB_INDEX_CONNECTIONS_COUNT:-5},
    "EnableTransactions": "${MONGODB_ENABLE_TRANSACTIONS:-Auto}",
    "CreateIndexesAtStartup": ${MONGODB_CREATE_INDEXES_AT_STARTUP:-true},
    "EnableExtendedFind": ${MONGODB_ENABLE_EXTENDED_FIND:-true}
  }
}
